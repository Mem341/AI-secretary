# Required
OWNER_TELEGRAM_ID=        # your numeric Telegram ID (@userinfobot); the bot answers only this person
TELEGRAM_BOT_TOKEN=       # @BotFather
OPENROUTER_API_KEY=       # https://openrouter.ai/keys
DATABASE_URL=             # set automatically by the Neon integration on Vercel

# Optional
GOOGLE_CLIENT_ID=         # Google Calendar; /api/setup shows how to create the OAuth client
GOOGLE_CLIENT_SECRET=
ELEVENLABS_API_KEY=       # voice messages
LLM_MODEL=google/gemini-2.5-flash
LLM_MODEL_SUMMARY=anthropic/claude-sonnet-4.5
STT_MODEL=scribe_v1
ENCRYPTION_KEY=           # defaults to a key derived from the bot token; never change once calendars are connected
TELEGRAM_WEBHOOK_SECRET=  # defaults to a secret derived from the bot token
CRON_SECRET=              # when set, only Vercel Cron can call /api/cron/daily
PUBLIC_URL=               # custom domain; defaults to the Vercel production URL
