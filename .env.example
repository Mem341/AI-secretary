# Required
OWNER_TELEGRAM_ID=        # your numeric Telegram ID (@userinfobot); the bot answers only this person
TELEGRAM_BOT_TOKEN=       # @BotFather
OPENROUTER_API_KEY=       # https://openrouter.ai/keys
GOOGLE_CLIENT_JSON=       # the downloaded JSON of a Google OAuth client, type Desktop app (docs/what-you-need.md §4)

# Optional
ZOOM_ACCOUNT_ID=          # Zoom as a meeting format (Server-to-Server OAuth app)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
BITRIX_WEBHOOK_URL=       # optional: Bitrix24 incoming webhook https://<portal>/rest/<user>/<code>/ (rights: Tasks, Users)
GMAIL_PUBSUB_TOPIC=       # projects/<id>/topics/<name> — instant new-mail notifications
AGENT_MODEL=openai/gpt-oss-120b       # text requests: Supervisor + Calendar/Gmail agents (cheap, tool calling)
VISION_MODEL=qwen/qwen3.7-flash       # requests with pictures (screenshots, photos)
LLM_MODEL=openai/gpt-6-luna-pro        # voice requests + retry when the cheap model fails
REMINDER_MINUTES=30,10             # Telegram reminders before a meeting (/api/cron/reminders, needs a 5-minute pinger)
LLM_MODEL_SUMMARY=anthropic/claude-sonnet-4.5
STT_MODEL=google/gemini-2.5-flash   # transcribes voice; must accept OGG audio (OpenAI models on OpenRouter do not)
ENCRYPTION_KEY=           # defaults to a key derived from the bot token; changing it means reconnecting Google
TELEGRAM_WEBHOOK_SECRET=  # defaults to a secret derived from the bot token
CRON_SECRET=              # when set, only the scheduler can call /api/cron/daily
OWNER_NAME=               # for event descriptions; defaults to your Telegram name
OWNER_POSITION=
OWNER_PHONE=
DEFAULT_DURATION_MIN=60
DEFAULT_FORMAT=offline    # offline | google_meet | zoom
DEFAULT_ADDRESS=          # for offline meetings when the chat names no place
PUBLIC_URL=               # custom domain; defaults to the Vercel production URL
