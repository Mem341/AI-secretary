# Required
OWNER_TELEGRAM_ID=        # your numeric Telegram ID (@userinfobot); the bot answers only this person
TELEGRAM_BOT_TOKEN=       # @BotFather
OPENROUTER_API_KEY=       # https://openrouter.ai/keys
DATABASE_URL=             # Postgres; set automatically by the Neon integration on Vercel, a neon.tech URL on AWS

# Optional
GOOGLE_CLIENT_ID=         # Google Calendar + Gmail; /api/setup shows how to create the OAuth client
GOOGLE_CLIENT_SECRET=
ELEVENLABS_API_KEY=       # voice messages
ZOOM_ACCOUNT_ID=          # Zoom as a meeting format (Server-to-Server OAuth app)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=       # projects/<id>/topics/<name> — instant new-mail notifications
LLM_MODEL=google/gemini-2.5-flash   # default OpenRouter model; the owner can pick another in /settings
LLM_MODEL_SUMMARY=anthropic/claude-sonnet-4.5
STT_MODEL=scribe_v1
ENCRYPTION_KEY=           # defaults to a key derived from the bot token; never change once calendars are connected
TELEGRAM_WEBHOOK_SECRET=  # defaults to a secret derived from the bot token
CRON_SECRET=              # when set, only the scheduler can call /api/cron/daily
PUBLIC_URL=               # custom domain; defaults to the Vercel production URL / the AWS Function URL
